# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/quakecheck
# For MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/quakecheck

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Python Routing Microservice
ROUTING_SERVICE_URL=http://localhost:8000

# Python ML severity service (ml-service/) — advisory admin-only prediction
ML_SERVICE_URL=http://localhost:8001
# Which stored earthquake is "matched" to an SOS (by the SOS's own location and creation time).
# Practical heuristics, shown in the admin panel; defaults in parentheses.
SEVERITY_QUAKE_WINDOW_HOURS=24   # look this many hours back from the SOS (24)
SEVERITY_MATCH_RADIUS_KM=300     # within this distance of the SOS (300)
SEVERITY_MIN_MAGNITUDE=4.0       # ignore smaller events (4.0)

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
