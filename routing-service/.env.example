# URL of the self-hosted OSRM routed server (see setup instructions).
# Default assumes OSRM is running locally, mapped to port 5001 — NOT 5000,
# since the Node backend already uses 5000.
OSRM_URL=http://localhost:5001

# OSRM routing profile. "driving" matches the standard car.lua profile used
# in the recommended OSRM setup. Only change this if you built OSRM with a
# different profile (e.g. "foot" for a walking-only extract).
OSRM_PROFILE=driving
